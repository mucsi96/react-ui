{
  "name": "@mucsi96/react-ui",
  "version": "0.1.0",
  "description": "Dark-first, accessible React components with CSS Modules and a cohesive semantic palette.",
  "type": "module",
  "license": "MIT",
  "author": "Igor Bari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mucsi96/react-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://mucsi96.github.io/react-ui/",
  "bugs": "https://github.com/mucsi96/react-ui/issues",
  "keywords": [
    "react",
    "components",
    "css-modules",
    "accessible",
    "dark-theme",
    "react-aria"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "react-aria-components": "1.22.1"
  }
}
